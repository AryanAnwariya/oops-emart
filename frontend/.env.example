# Social login is hidden unless you enable it. Only enable a provider after its
# console (Google Cloud / Meta for Developers) lists your site's origin, e.g.
# http://localhost:3000 and https://oops-emart.onrender.com.
# Client IDs are public build-time values; never put client secrets here.

VITE_ENABLE_GOOGLE_LOGIN=false
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

VITE_ENABLE_FACEBOOK_LOGIN=false
VITE_FACEBOOK_APP_ID=your-facebook-app-id-here
